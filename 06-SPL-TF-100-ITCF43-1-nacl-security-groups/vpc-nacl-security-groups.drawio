      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;SPL-TF-100-ITCF43-1 - Network ACLs and Security Groups in Amazon VPC&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6B85&quot; style=&quot;font-size:12px&quot;&gt;Two public subnets, each protected by a stateless network ACL and a stateful security group&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#2B3A55;" parent="1" vertex="1">
          <mxGeometry x="40" y="10" width="900" height="50" as="geometry" />
        </mxCell>
